# PS1 / prompt customization

source ~/.bash/config

repeat_char() {
    local input="$1"
    local count="$2"
    printf -v myString '%*s' "$count"
    printf '%s\n' "${myString// /$input}"
}

fill_ps() {
    local left_ps right_ps left right
	left_ps=$(get_left_ps)
	right_ps=$(get_right_ps)
    left=$(visible_length "$left_ps")
    right=$(visible_length "$right_ps")

    local available=$((COLUMNS - left - right))
    local separator_width=${#MIDDLE_SEPARATOR}

    (( available < 0 )) && available=0

    local count=$((available / separator_width))

    echo -e "$left_ps$(repeat_char $MIDDLE_SEPARATOR $count)$right_ps\n$PROMPT_ENTRY "
}

PS1="\$(fill_ps)"

# path customization

export HELIX_RUNTIME=$HOME/src/helix/runtime
export PATH="$PATH:$HOME/.cargo/bin"

